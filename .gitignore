/ultra-agent.toml
/state/
/vault/
/work/
/sessions/
/handoffs/

# Runtime state, logs and databases anywhere in the workspace
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log

# Private orchestration metadata
.omo/

# Environment and secrets
.env
.env.*
!.env.example

